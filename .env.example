# === Database (wajib) ===
# PostgreSQL connection string (Neon / Supabase / VPS / lokal)
DATABASE_URL=postgres://postgres@localhost:5433/kakarut

# === Server ===
PORT=3000
# WAJIB diganti di produksi (dipakai untuk menandatangani JWT)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
# Migrasi database otomatis saat server start (default true).
# Set false bila migrasi dijalankan terpisah (mis. hanya via entrypoint Docker/CI).
# AUTO_MIGRATE=true
#
# Berapa proxy yang ADA DI DEPAN aplikasi ini (default 1 = satu Traefik/Dokploy,
# sesuai docker-compose.yml di repo ini). Menentukan berapa entri
# `X-Forwarded-For` dari ujung KANAN yang boleh dipercaya sebagai IP klien —
# dan IP itulah kunci pembatas laju login/lupa-password/daftar.
#
# Entri paling KIRI selalu dikirim klien dan bebas dipalsukan; membacanya membuat
# pembatas laju bisa dimatikan cukup dengan mengganti satu header tiap permintaan.
#
#   0 → aplikasi diekspos LANGSUNG tanpa proxy (XFF diabaikan sepenuhnya)
#   1 → satu proxy (bawaan)
#   2 → CDN di depan Traefik
#
# Salah setel BUKAN sekadar kurang rapi: terlalu besar membuat entri palsu
# terpakai lagi; terlalu kecil membuat semua pengguna berbagi satu ember
# (alamat kontainer proxy) dan saling menghabiskan jatah login.
# TRUST_PROXY_HOPS=1

# === Cloudflare R2 (opsional — jika kosong, upload disimpan di disk lokal) ===
# Account ID Cloudflare Anda (dashboard R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nama bucket R2
R2_BUCKET=
# URL publik bucket (custom domain atau r2.dev), tanpa trailing slash,
# mis. https://cdn.perusahaan-anda.com
R2_PUBLIC_URL=

# Folder penyimpanan upload saat mode lokal (default: apps/server/uploads)
# UPLOAD_DIR=

# === Pencadangan (backup) database (opsional) ===
# Pencadangan otomatis ke storage cadangan (R2 privat / disk lokal).
# BACKUP_ENABLED=true
# Jam LOKAL jadwal harian (0-23), default 2 = 02:00 dini hari saat outlet tutup
# BACKUP_HOUR=2
# Paksa zona waktu jadwal. Kosongkan agar mengikuti zona waktu tenant terbanyak.
# BACKUP_TIMEZONE=Asia/Jakarta
# Retensi: jumlah cadangan sukses terakhir yang disimpan, default 14
# BACKUP_KEEP=14
# Folder cadangan saat mode LOKAL (default <uploads>/../backups).
# Di kontainer arahkan ke volume ter-mount agar tak hilang saat re-deploy.
# BACKUP_DIR=
# Bucket R2 PRIVAT khusus cadangan (opsional). Bila kosong memakai R2_BUCKET
# dengan prefix backups/. Cadangan tak pernah dilayani lewat URL publik.
# R2_BACKUP_BUCKET=

# === Seed (opsional, override kredensial default) ===
# SEED_SUPERADMIN_EMAIL=superadmin@kakarut.id
# SEED_SUPERADMIN_PASSWORD=
# SEED_OWNER_EMAIL=terahokiindonesia@gmail.com
# SEED_OWNER_PASSWORD=
# SEED_KASIR_EMAIL=kasir@basooopa.id
# SEED_KASIR_PASSWORD=
# SEED_DEMO_STOCK=true
