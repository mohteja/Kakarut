# === Database (wajib) ===
# PostgreSQL connection string (Neon / Supabase / VPS / lokal)
DATABASE_URL=postgres://postgres@localhost:5433/kakarut

# === Server ===
PORT=3000
# WAJIB diganti di produksi (dipakai untuk menandatangani JWT)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
# Migrasi database otomatis saat server start (default true).
# Set false bila migrasi dijalankan terpisah (mis. hanya via entrypoint Docker/CI).
# AUTO_MIGRATE=true

# === Cloudflare R2 (opsional — jika kosong, upload disimpan di disk lokal) ===
# Account ID Cloudflare Anda (dashboard R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nama bucket R2
R2_BUCKET=
# URL publik bucket (custom domain atau r2.dev), tanpa trailing slash,
# mis. https://cdn.perusahaan-anda.com
R2_PUBLIC_URL=

# Folder penyimpanan upload saat mode lokal (default: apps/server/uploads)
# UPLOAD_DIR=

# === Seed (opsional, override kredensial default) ===
# SEED_SUPERADMIN_EMAIL=superadmin@kakarut.id
# SEED_SUPERADMIN_PASSWORD=
# SEED_OWNER_EMAIL=terahokiindonesia@gmail.com
# SEED_OWNER_PASSWORD=
# SEED_KASIR_EMAIL=kasir@basooopa.id
# SEED_KASIR_PASSWORD=
# SEED_DEMO_STOCK=true
